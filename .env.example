# Keep the web app and API bound to this machine by default.
APP_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4040

# Backend process settings forwarded into the backend container.
BACKEND_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: path inside the backend container to a backup.json used to seed an
# empty database. Leave unset on a normal install. Seeded rows are adopted on
# first sign-in only when AUTH_ALLOWED_EMAILS lists exactly one account.
# WARROOM_INITIAL_BACKUP=

# Company domains are not sent to third-party favicon services by default.
LOGO_LOOKUP_ENABLED=false

# Mandatory Google Sign-In. Only accounts listed here (comma-separated,
# case-insensitive) may ever hold a session; everyone else is rejected and
# the attempt is logged. Required in any real deployment — leaving this
# empty denies every sign-in attempt.
AUTH_ALLOWED_EMAILS=
# Generate with: openssl rand -base64 32. Encrypts stored Google refresh/
# access tokens at rest. Keep this separate from GOOGLE_BACKUP_ENCRYPTION_KEY
# below: rotating one must never invalidate the other.
AUTH_TOKEN_ENCRYPTION_KEY=
# Keep true in every real deployment (HTTPS is required for the session
# cookie to be sent). Set to false only for local plain-HTTP testing —
# never in a real deployment.
SESSION_COOKIE_SECURE=true

# Signing in also grants Drive access (one combined OAuth consent) — there
# is no separate "connect Drive" step. Create a Google Cloud web OAuth
# client, add GOOGLE_REDIRECT_URI as a redirect URI and your frontend origin
# (e.g. https://your-domain.example, plus localhost:3000 and 127.0.0.1:3000
# for local development) as JavaScript origins, then enable Picker and Drive
# APIs in that project. Restrict GOOGLE_PICKER_API_KEY to those APIs and HTTP
# referrers for your frontend origin and https://docs.google.com/*. The
# Cloud project number is derived from the OAuth client ID; set
# GOOGLE_CLOUD_PROJECT_NUMBER only if it cannot be derived. Leave keys empty
# to disable sign-in and Drive backup entirely. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32. Keep this key with your passwords;
# portable or Drive backups cannot be exported or restored without it.
GOOGLE_BACKUP_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_REDIRECT_URI=http://localhost:4040/api/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
