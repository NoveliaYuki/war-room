# Keep the web app and API bound to this machine by default.
APP_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4040

# Backend process settings forwarded into the backend container.
BACKEND_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Company domains are not sent to third-party favicon services by default.
LOGO_LOOKUP_ENABLED=false

# Optional Google Drive auto-backup. Create a Google Cloud web OAuth client,
# add GOOGLE_REDIRECT_URI as a redirect URI and localhost:3000 and
# 127.0.0.1:3000 as JavaScript origins, then enable Picker and Drive APIs in
# that project. Restrict GOOGLE_PICKER_API_KEY to those APIs and HTTP referrers
# for localhost:3000, 127.0.0.1:3000, and https://docs.google.com/*. Use the
# Cloud project number is derived from the OAuth client ID; set
# GOOGLE_CLOUD_PROJECT_NUMBER only if it cannot be derived. Leave keys empty to
# disable Drive backup. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32. Keep this key with your passwords;
# portable or Drive backups cannot be exported or restored without it.
GOOGLE_BACKUP_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_REDIRECT_URI=http://localhost:4040/api/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
